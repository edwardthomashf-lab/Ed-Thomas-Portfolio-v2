---
import { Picture } from 'astro:assets';
import type { Project } from '../content/projects';

interface Props {
  project: Project;
  /** `card` sits in the index; `dialog` is the larger overlay copy. */
  variant: 'card' | 'dialog';
}

const { project, variant } = Astro.props;
// In the index the card's text names the project, so its media is decorative.
const isCard = variant === 'card';
---

<span class:list={['media', `media--${variant}`]} data-media={project.id}>
  <Picture
    src={project.image}
    formats={['avif', 'webp']}
    widths={isCard ? [480, 720, 960] : [800, 1200, 1600]}
    sizes={isCard
      ? '(min-width: 1024px) 30vw, (min-width: 720px) 36vw, 80vw'
      : '(min-width: 1024px) 62vw, 92vw'}
    alt={isCard ? '' : project.alt}
    class="media-img media__img"
    loading="lazy"
    decoding="async"
  />
  <span
    class="media-swatch swatch"
    style={`--sw-bg:${project.brand.bg};--sw-fg:${project.brand.fg}`}
    role={isCard ? undefined : 'img'}
    aria-hidden={isCard ? 'true' : undefined}
    aria-label={isCard ? undefined : `${project.title} brand colours, ${project.brand.bg} and ${project.brand.fg}`}
  >
    <span class="swatch__name">{project.title}</span>
    <span class="swatch__hex">{project.brand.bg.toUpperCase()}<br />{project.brand.fg.toUpperCase()}</span>
  </span>
</span>

<style lang="scss">
  .media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-radius: 3px;
    background: var(--bg-hover);
  }

  .media--card {
    border-radius: 8px;
    box-shadow:
      0 1px 2px color-mix(in oklab, #000 8%, transparent),
      0 30px 60px -30px color-mix(in oklab, #000 45%, transparent);
    transition: box-shadow var(--dur-2) var(--ease-out);

    // Fallback light: a soft highlight that follows the cursor when WebGL
    // isn't drawing the water (no WebGL, or the canvas hasn't loaded yet).
    &::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background:
        radial-gradient(
          circle at var(--mx, 50%) var(--my, 30%),
          rgb(255 255 255 / 0.28),
          rgb(255 255 255 / 0.06) 28%,
          transparent 55%
        );
      mix-blend-mode: soft-light;
      opacity: var(--sheen, 0);
      transition: opacity var(--dur-2) var(--ease-out);
    }

    // The WebGL layer is drawing this card: hand the pixels over to it.
    &.is-gl {
      background: transparent;

      .media__img {
        opacity: 0;
      }

      &::after {
        display: none;
      }
    }

    // While morphing into the overlay the real image must be visible.
    &.is-gl.is-morph .media__img {
      opacity: 1;
    }
  }

  .media__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .swatch {
    position: absolute;
    inset: 0;
    align-content: space-between;
    padding: clamp(10px, 4%, 18px);
    background: var(--sw-bg);
    color: var(--sw-fg);
  }

  .swatch__name {
    font-size: clamp(1rem, 0.6rem + 1vw, 1.5rem);
    font-weight: 500;
    letter-spacing: var(--tracking-tight);
    line-height: 1;
  }

  .swatch__hex {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.4;
  }

  .media--dialog .swatch__name {
    font-size: clamp(2rem, 1rem + 4vw, 5rem);
  }
</style>
