---
import { site } from '../content/site';
---

<aside class="status" aria-label="Status bar">
  <a class="status__name" href="#top">{site.name}</a>

  <nav class="status__nav" aria-label="Sections">
    <a class="tap draw" href="#work">Work</a>{', '}
    <a class="tap draw" href="#about">About</a>{', '}
    <a class="tap draw" href="#contact">Contact</a>
  </nav>

  <p class="status__clock">
    <span class="muted">Chelmsford</span>
    <time data-clock>--:--:--</time>
    <span class="muted" data-zone>GMT</span>
  </p>

  <a class="status__pill" href="#contact">
    <span class="pulse" aria-hidden="true"></span>
    Open to roles
  </a>
</aside>

<script>
  import { site } from '../content/site';

  const clock = document.querySelector<HTMLTimeElement>('[data-clock]');
  const zone = document.querySelector<HTMLElement>('[data-zone]');

  const time = new Intl.DateTimeFormat('en-GB', {
    timeZone: site.timeZone,
    hour: '2-digit',
    minute: '2-digit',
    second: '2-digit',
    hour12: false,
  });
  const zoneName = new Intl.DateTimeFormat('en-GB', { timeZone: site.timeZone, timeZoneName: 'short' });

  function tick() {
    const now = new Date();
    if (clock) {
      clock.textContent = time.format(now);
      clock.dateTime = now.toISOString();
    }
    if (zone) {
      zone.textContent = zoneName.formatToParts(now).find((p) => p.type === 'timeZoneName')?.value ?? '';
    }
  }

  tick();
  // Align ticks to the second boundary so the seconds don't stutter.
  setTimeout(() => {
    tick();
    setInterval(tick, 1000);
  }, 1000 - (Date.now() % 1000));
</script>

<style lang="scss">
  @use '../styles/mq' as *;

  .status {
    position: fixed;
    inset: auto 0 0;
    z-index: 20;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    column-gap: var(--gutter);
    height: var(--status-h);
    padding: 0 var(--margin);
    border-top: 1px solid var(--rule);
    background: color-mix(in oklab, var(--bg) 82%, transparent);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    font-size: var(--text-small);
    line-height: 1;

    @include from($desktop) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .status__name {
    display: none;

    @include from($desktop) {
      display: block;
      font-weight: 500;
    }
  }

  .status__nav {
    display: none;

    @include from($desktop) {
      display: block;
    }
  }

  .status__clock {
    font-variant-numeric: tabular-nums;

    time {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      margin-inline: 0.5ch;
    }
  }

  .status__pill {
    justify-self: end;
    display: inline-flex;
    align-items: center;
    padding: 7px 12px;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: var(--bg);
    transition:
      border-color var(--dur-1) var(--ease-out),
      transform var(--dur-2) var(--ease-spring);

    &:hover {
      border-color: var(--accent);
      transform: translateY(-1px);
    }
  }
</style>
