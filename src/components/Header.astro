---
import { site } from '../content/site';
import Settings from './Settings.astro';

/**
 * Each letter is its own span so the name can rise in one character at a
 * time, and then lift away at its own speed as you scroll off the landing.
 */
const speedFor = (i: number) => (1.12 + ((i * 7) % 5) * 0.07).toFixed(2);
const split = (word: string, offset = 0) =>
  [...word].map((ch, i) => ({ ch, i: i + offset, speed: speedFor(i + offset) }));

const first = split(site.firstName);
const last = split(site.lastName, site.firstName.length);
---

<header class="masthead" id="top">
  <h1 class="name">
    <span class="visually-hidden">{site.name}, {site.role}</span>
    <span class="name__word" aria-hidden="true" data-drift="-0.14" data-anchor="top">
      {first.map(({ ch, i, speed }) => <span class="ch" data-speed={speed} data-anchor="top" style={`--i:${i}`}>{ch}</span>)}
    </span>
    <span class="name__word" aria-hidden="true" data-drift="0.14" data-anchor="top">
      {last.map(({ ch, i, speed }) => <span class="ch" data-speed={speed} data-anchor="top" style={`--i:${i}`}>{ch}</span>)}
    </span>
  </h1>

  <div class="meta">
    <p class="meta__col">
      {site.role}
      <span class="muted">{site.focus}</span>
    </p>

    <nav class="meta__col" aria-label="Primary">
      <ul>
        <li><a class="tap draw" href="#work">Work</a></li>
        <li><a class="tap draw" href="#about">About</a></li>
        <li><a class="tap draw" href="#contact">Contact</a></li>
      </ul>
    </nav>

    <div class="meta__col">
      <Settings />
    </div>

    <p class="meta__col meta__col--end">
      {site.location}
      <span class="muted">{site.coordinates}</span>
    </p>
  </div>
</header>

<script>
  const name = document.querySelector('.name');
  const settle = () => name?.classList.add('is-settled');
  if (document.documentElement.dataset.motion === 'on') setTimeout(settle, 1900);
  else settle();
</script>

<style lang="scss">
  @use '../styles/mq' as *;

  .masthead {
    // The name's words drift apart sideways as you scroll; never let that
    // widen the page (clip keeps vertical overflow for the letters lifting away).
    overflow-x: clip;
    padding: clamp(12px, 1.4vw, 20px) var(--margin) 0;
  }

  .name {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    column-gap: 0.12em;
    font-size: var(--text-display);
    font-weight: 500;
    line-height: 0.82;
    letter-spacing: var(--tracking-display);
    // Optical: pull the E's stem flush with the page margin.
    margin-left: -0.055em;
    padding-bottom: clamp(10px, 1.2vw, 18px);

    @include below($tablet) {
      flex-direction: column;
      align-items: flex-start;
      font-size: 25vw;
      row-gap: 0.04em;
    }
  }

  .name__word {
    display: inline-flex;
    // Clip below the baseline only, so letters rise out of an invisible slot.
    // Once they've landed the clip comes off, so they can lift away freely.
    clip-path: inset(-0.4em -0.2em 0 -0.2em);
    padding-right: 0.06em;
  }

  .name.is-settled .name__word {
    clip-path: none;
  }

  .ch {
    display: inline-block;
  }

  :global(html.js[data-motion='on']) .ch {
    animation: rise 1.1s var(--ease-out) both;
    animation-delay: calc(120ms + var(--i) * 45ms);
  }

  @keyframes rise {
    from {
      transform: translateY(105%);
    }
  }

  .meta {
    @include index-grid;
    row-gap: 18px;

    @include below($tablet) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    padding-top: 12px;
    border-top: 1px solid var(--rule);
    font-size: var(--text-meta);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: -0.005em;
  }

  .meta__col {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    ul {
      display: grid;
    }

    // The primary nav: full ink, so it reads first while staying thin.
    a {
      color: var(--fg);
    }
  }

  // Text columns sit on the same optical line as the 24px-tall links beside them.
  p.meta__col {
    padding-top: 2px;
  }

  .meta__col--end {
    @include from($desktop) {
      align-items: flex-end;
      text-align: right;
    }
  }

  :global(html.js[data-motion='on']) .meta {
    animation: fade 900ms var(--ease-out) 700ms both;
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }
</style>
