---
import type { Project } from '../content/projects';
import ProjectMedia from './ProjectMedia.astro';

interface Props {
  project: Project;
  number: string;
}

const { project, number } = Astro.props;
const titleId = `project-${project.id}-title`;
---

<dialog
  class="project"
  id={`project-${project.id}`}
  aria-labelledby={titleId}
  data-project={project.id}
  data-lenis-prevent
>
  <div class="project__inner">
    <header class="project__bar">
      <p class="label">( {number} ) {project.kind}</p>
      <button type="button" class="project__close" data-close>
        Close <span class="label" aria-hidden="true">( Esc )</span>
      </button>
    </header>

    <div class="project__body">
      <div class="project__media">
        <ProjectMedia project={project} variant="dialog" />
      </div>

      <div class="project__info">
        <h3 class="project__title" id={titleId}>{project.title}</h3>
        <p class="project__summary">{project.summary}</p>
        {project.results && <p class="project__results">{project.results}</p>}

        <dl class="project__meta">
          <div>
            <dt class="label">Type</dt>
            <dd>{project.type}</dd>
          </div>
          <div>
            <dt class="label">Year</dt>
            <dd>{project.year}</dd>
          </div>
          <div>
            <dt class="label">Role</dt>
            <dd>{project.role}</dd>
          </div>
          <div class="project__stack">
            <dt class="label">Stack</dt>
            <dd>{project.stack.join(', ')}</dd>
          </div>
        </dl>

        <a class="project__visit" href={project.url} target="_blank" rel="noopener">
          <span class="draw">Visit {project.displayUrl}</span>
          <span aria-hidden="true">↗</span>
          <span class="visually-hidden">(opens in a new tab)</span>
        </a>
      </div>
    </div>
  </div>
</dialog>

<style lang="scss">
  @use '../styles/mq' as *;

  .project {
    width: calc(100vw - var(--margin) * 2);
    max-width: 1600px;
    height: calc(100dvh - var(--margin) * 2);
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 6px;
    background: var(--bg);
    color: var(--fg);
    overscroll-behavior: contain;

    // Fallback entrance when view transitions are unavailable.
    opacity: 0;
    transition:
      opacity var(--dur-2) var(--ease-out),
      overlay var(--dur-2) allow-discrete,
      display var(--dur-2) allow-discrete;

    &[open] {
      opacity: 1;

      @starting-style {
        opacity: 0;
      }
    }

    &::backdrop {
      background: var(--overlay-scrim);
      backdrop-filter: blur(6px);
      opacity: 0;
      transition:
        opacity var(--dur-2) var(--ease-out),
        overlay var(--dur-2) allow-discrete,
        display var(--dur-2) allow-discrete;
    }

    &[open]::backdrop {
      opacity: 1;

      @starting-style {
        opacity: 0;
      }
    }
  }

  .project__inner {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 100%;
  }

  .project__bar {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px clamp(16px, 2vw, 28px);
    background: var(--bg);
    border-bottom: 1px solid var(--rule);
  }

  .project__close {
    display: inline-flex;
    gap: 1ch;
    align-items: baseline;
    font-size: var(--text-small);

    &:hover .label {
      color: var(--fg);
    }
  }

  .project__body {
    display: grid;
    gap: clamp(24px, 3vw, 48px);
    align-content: start;
    padding: clamp(16px, 2vw, 28px);

    @include from($desktop) {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      align-content: stretch;
    }
  }

  .project__info {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }

  .project__title {
    font-size: clamp(2.25rem, 1.2rem + 3.6vw, 4.75rem);
    line-height: 0.92;
    letter-spacing: var(--tracking-display);
  }

  .project__summary {
    font-size: clamp(1.0625rem, 0.95rem + 0.4vw, 1.3125rem);
    line-height: 1.35;
    max-width: 36rem;
    text-wrap: pretty;
  }

  .project__results {
    padding-left: 12px;
    border-left: 2px solid var(--accent);
    font-size: var(--text-small);
    color: var(--fg-muted);
  }

  .project__meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px var(--gutter);
    padding-top: 12px;
    border-top: 1px dashed var(--rule-strong);
    font-size: var(--text-small);

    dd {
      margin-top: 3px;
    }
  }

  .project__stack {
    grid-column: 1 / -1;

    dd {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      line-height: 1.5;
    }
  }

  .project__visit {
    display: inline-flex;
    gap: 0.6ch;
    align-self: flex-start;
    margin-top: auto;
    padding: 10px 16px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    font-size: var(--text-small);
    transition: transform var(--dur-2) var(--ease-spring);

    &:hover {
      transform: translateY(-2px);
    }
  }
</style>
