---
import { contact, site } from '../content/site';
const year = new Date().getFullYear();
---

<footer id="contact" class="contact" aria-labelledby="contact-title">
  <div class="contact__head">
    <p class="label">( Contact )</p>
    <p class="contact__line">{contact.line}</p>
  </div>

  <h2 id="contact-title" class="contact__title" data-reveal data-speed="0.9" data-anchor="bottom">{contact.heading}</h2>

  <a class="contact__email" href={`mailto:${site.email}`} data-reveal>
    <span class="draw">{site.email}</span>
  </a>

  <div class="contact__grid">
    <div>
      <h3 class="label">Elsewhere</h3>
      <ul class="contact__links">
        <li>
          <a class="tap draw" href={site.githubUrl} target="_blank" rel="noopener me">
            GitHub <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a class="tap draw" href={site.linkedinUrl} target="_blank" rel="noopener me">
            LinkedIn <span aria-hidden="true">↗</span><span class="visually-hidden">(opens in a new tab)</span>
          </a>
        </li>
        <li>
          <a class="tap draw" href={site.cvUrl} download>
            CV <span class="muted">(PDF)</span> <span aria-hidden="true">↓</span>
          </a>
        </li>
      </ul>
    </div>

    <div>
      <h3 class="label">Colophon</h3>
      <p class="muted">
        Set in General Sans and Geist Mono. Built with Astro, TypeScript and SCSS, on a token
        system you can re-theme from the header. Hosted on Netlify.
      </p>
    </div>

    <div>
      <h3 class="label">Based</h3>
      <p class="muted">{site.location}<br />{site.coordinates}</p>
    </div>

    <div class="contact__end">
      <p class="muted">© {year} {site.name}</p>
      <a class="tap draw" href="#top">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</footer>

<style lang="scss">
  @use '../styles/mq' as *;

  .contact {
    margin-top: var(--section);
    padding: 10px var(--margin) clamp(32px, 4vw, 56px);
    border-top: 1px solid var(--rule);
  }

  .contact__head {
    @include index-grid;
    row-gap: 4px;
  }

  .contact__line {
    color: var(--fg-muted);

    @include from($desktop) {
      grid-column: 2 / span 2;
    }
  }

  .contact__title {
    margin-top: clamp(72px, 8vw, 120px);
    margin-left: -0.05em;
    font-size: clamp(3.5rem, 12vw, 13rem);
    line-height: 0.86;
    letter-spacing: var(--tracking-display);
  }

  .contact__email {
    display: inline-block;
    padding-block: 6px;
    margin-top: clamp(26px, 3.6vw, 50px);
    font-size: clamp(1.125rem, 4.6vw, 3.25rem);
    letter-spacing: var(--tracking-tight);
    line-height: 1.1;
    font-weight: 500;
    overflow-wrap: anywhere;

    .draw {
      background-size: 100% 1px;
      background-image: linear-gradient(var(--rule-strong), var(--rule-strong));
      padding-bottom: 0.06em;
    }

    &:hover .draw,
    &:focus-visible .draw {
      background-image: linear-gradient(var(--accent), var(--accent));
      animation: redraw var(--dur-3) var(--ease-out);
    }
  }

  @keyframes redraw {
    from {
      background-size: 0% 1px;
    }
  }

  .contact__grid {
    @include index-grid;
    row-gap: 28px;
    margin-top: clamp(64px, 9vw, 140px);
    padding-top: 10px;
    border-top: 1px solid var(--rule);
    font-size: var(--text-small);
    line-height: 1.35;

    h3 {
      margin-bottom: 6px;
      font-weight: 400;
    }

    p {
      max-width: 34ch;
    }
  }

  .contact__links {
    display: grid;
    justify-items: start;
  }

  .contact__end {
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: flex-start;

    @include from($desktop) {
      align-items: flex-end;
      justify-content: space-between;
    }
  }
</style>
